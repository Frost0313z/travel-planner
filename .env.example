# 이 파일을 복사해 .env로 저장하고 실제 키 값을 채운 뒤 사용하세요.
# .env는 .gitignore에 등록되어 있어 저장소에 커밋되지 않습니다.

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# NAVER API HUB 지역 검색 애플리케이션의 인증 정보
# (NAVER Cloud Platform 콘솔 > Application Services > NAVER API HUB > Application)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
